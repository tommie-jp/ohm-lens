{
  "name": "ohm-lens",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Webカメラに映した抵抗器の抵抗値をリアルタイムでオーバーレイ表示する Web アプリ",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "lint:md": "markdownlint \"**/*.md\""
  },
  "dependencies": {
    "culori": "^4.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/culori": "^4.0.1",
    "@types/node": "^26.1.1",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.8.0",
    "markdownlint-cli": "^0.49.1",
    "sharp": "^0.35.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "brace-expansion": "^5.0.8"
  }
}
